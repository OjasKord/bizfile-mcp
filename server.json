{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.OjasKord/bizfile-mcp",
  "description": "Company verification and KYC across 130+ jurisdictions via global registries.",
  "repository": {
    "url": "https://github.com/OjasKord/bizfile-mcp",
    "source": "github"
  },
  "version": "1.3.1",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "bizfile-mcp",
      "version": "1.3.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ANTHROPIC_API_KEY",
          "description": "Anthropic API key from console.anthropic.com",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "COMPANIES_HOUSE_API_KEY",
          "description": "Free UK Companies House API key",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
